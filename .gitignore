# Raw external downloads (HM Land Registry, Police.uk, ONS, schools, bus stops)
# — these are large gov.uk/police.uk source files, not shipped in this repo.
# See data/README.md for where to download them. The cleaned zip snapshots
# below (data/raw/*.zip) ARE tracked — they're what the notebook actually ships with.
data/raw/house_prices/
data/raw/crime/
data/raw/geo/
data/raw/schools-lep.csv
data/raw/Bus_Stops.csv

# Regenerated on first notebook run by unzipping data/raw/*.zip — no need to
# track these large CSVs separately from the zips that produce them.
data/processed/house_prices_bristol_clean.csv
data/processed/crime_bristol_clean.csv

